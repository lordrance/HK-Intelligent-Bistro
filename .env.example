# Server reads these at runtime — never commit real secrets
# Required for AI Concierge (POST /assistant/intent). If empty, the API returns a friendly message instead of 500.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
SERVER_PORT=8787

# Auth (required for /catalog and /assistant/intent) — use a long random string
JWT_SECRET=
# Optional: SQLite file (default: apps/server/data/app.db inside the app)
# DATABASE_PATH=
# JWT_EXPIRES_DAYS=7

# Optional: published host port for `docker compose` (see docker-compose.yml)
# API_PORT=8787
