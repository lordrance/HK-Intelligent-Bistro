{
  "name": "hk-intelligent-bistro",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:server": "pnpm --filter @hk/server dev",
    "dev:mobile": "pnpm --filter @hk/mobile start",
    "build:shared": "pnpm --filter @hk/shared build",
    "build:server": "pnpm --filter @hk/server build",
    "test": "pnpm --filter @hk/shared test",
    "typecheck": "pnpm --filter @hk/shared build && pnpm --filter @hk/server exec tsc --noEmit && pnpm --filter @hk/mobile exec tsc --noEmit",
    "ci": "pnpm test && pnpm typecheck"
  }
}
